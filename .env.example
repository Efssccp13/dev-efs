# =====================================================================
# Copie este arquivo para backend/.env e preencha com os seus dados.
# O arquivo .env NUNCA deve ser enviado ao GitHub (já está no .gitignore).
# =====================================================================

# Connection string do Neon:
# Neon Dashboard > Connection Details > Connection string (com sslmode=require)
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chave da API do Gemini (crie em https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo usado pela Lia. gemini-2.5-flash é rápido e barato, ideal para chat.
GEMINI_MODEL=gemini-2.5-flash

# Origens que podem chamar a API (front local e deploy).
# Separe por vírgula, sem espaços.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500

# 1 = desenvolvimento (recarrega ao salvar) | 0 = produção
FLASK_DEBUG=1
